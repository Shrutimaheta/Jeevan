# Copy to deploy/.env.production on the host; never commit that file.
# DNS must point this single hostname to the host before requesting certificates.
JEEVAN_DOMAIN=
ACME_EMAIL=
JEEVAN_IMAGE_TAG=
# Compose derives allowed hosts/CSRF origins from JEEVAN_DOMAIN.
DJANGO_SECRET_KEY=
DB_NAME=jeevan
DB_USER=jeevan_runtime
DB_PASSWORD=
DB_MIGRATION_USER=jeevan_migrator
DB_MIGRATION_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SESSION_COOKIE_AGE=3600
TELECONSULTATION_ENABLED=false
TELECONSULTATION_ORIGIN=
TELECONSULTATION_ADMISSION_VERIFIED=false
