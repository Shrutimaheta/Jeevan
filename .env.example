# Runtime environment: development or production
JEEVAN_ENV=development

# Required in production. Generate a long random value and never commit it.
DJANGO_SECRET_KEY=

# Comma-separated values
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database. SQLite is intended only for local development.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_CONN_MAX_AGE=0

# Email. Production must use a real email backend and credentials.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=JeevanCare <noreply@example.com>

# Optional security controls
SESSION_COOKIE_AGE=3600
SECURE_HSTS_SECONDS=31536000

