# Runtime environment: development or production
JEEVAN_ENV=development
JEEVAN_DEMO_MODE=false

# Required in production. Generate a long random value and never commit it.
DJANGO_SECRET_KEY=

# Comma-separated values
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database. SQLite is intended only for local development.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_CONN_MAX_AGE=0

# Email. Production must use a real email backend and credentials.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=JeevanCare <noreply@example.com>

# Optional security controls
SESSION_COOKIE_AGE=3600
JEEVAN_TRUSTED_PROXY_NETWORKS=
SECURE_HSTS_SECONDS=31536000

# Required for a real-user production deployment: absolute durable-volume paths.
# Keep these unset locally to use the workspace directories.
# MEDIA_ROOT=/srv/jeevan/media
# PRIVATE_MEDIA_ROOT=/srv/jeevan/private_media
JEEVAN_PERSISTENT_STORAGE=false

# Video remains unavailable until provider admission/privacy are verified.
TELECONSULTATION_ENABLED=false
TELECONSULTATION_ORIGIN=
TELECONSULTATION_ADMISSION_VERIFIED=false

# Render deployment profiles are configured by render.yaml or deploy/render.production.yaml.
# Leave unset for ordinary local development and the Linux/Docker deployment.
# JEEVAN_RENDER_PROFILE=preview
# PREVIEW_ACCESS_TOKEN=
# PREVIEW_ACCOUNT_PASSWORD=

