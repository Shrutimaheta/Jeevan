# Runtime environment: development or production
JEEVAN_ENV=development

# Required in production. Generate a long random value and never commit it.
# Leave empty for local development (a development-only key is used).
DJANGO_SECRET_KEY=

# Comma-separated values
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database. SQLite is the default for local development.
# In production set DATABASE_URL (e.g. a Neon Postgres URL with ?sslmode=require).
DATABASE_URL=
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_CONN_MAX_AGE=0

# Email. Development prints emails to the console.
# Production: SMTP (EMAIL_HOST...) or an HTTP email API key below
# (needed on hosts that block SMTP, such as Render's free plan).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=JeevanCare <noreply@example.com>

# Optional security controls
SESSION_COOKIE_AGE=3600
SECURE_HSTS_SECONDS=31536000


# Demo deployments: shows a "sample data only" banner and one-click demo logins.
# Never enable where real patients use the system.
DEMO_MODE=false
DEMO_PASSWORD=Demo@2026
DEMO_ADMIN_PASSWORD=

# Behind a proxy (Render/Railway/Heroku) read the client IP from X-Forwarded-For.
# Defaults to true when JEEVAN_ENV=production.
# TRUST_X_FORWARDED_FOR=true

# Password reset by SMS needs an SMS provider; keep false until one is added.
SMS_ENABLED=false

# Optional: store uploads in a PRIVATE S3-compatible bucket (AWS S3, Cloudflare R2...)
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_REGION=

# Show /api/v1/docs/ in production (always shown in development)
API_DOCS_PUBLIC=false
